      "seed": 57733422,
      "version": 124,
      "versionNonce": 1946867502,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1784557516898,
      "link": null,
      "locked": false,
      "text": "    # Calculation",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "    # Calculation",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "i-VuervBbN8rZp9BuaGsE",
      "type": "text",
      "x": -419.15231556858157,
      "y": 2815.6861149684396,
      "width": 624.7999877929688,
      "height": 40,
      "angle": 0,
      "strokeColor": "#343a40",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0B",
      "roundness": null,
      "seed": 247205746,
      "version": 435,
      "versionNonce": 1272338030,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1784558107281,
      "link": null,
      "locked": false,
      "text": "    # For each `h_i` node in `P`, we divide the `N` on its capacity - 1\n    # Then multiply it by the node cost, to calculate the path waiting",
      "fontSize": 16,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "    # For each `h_i` node in `P`, we divide the `N` on its capacity - 1\n    # Then multiply it by the node cost, to calculate the path waiting",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "of55DjAQgJRgzLG4G55eB",
      "type": "text",
      "x": -423.0346088669791,
      "y": 3060.145501417903,
      "width": 473,
      "height": 50,
      "angle": 0,
      "strokeColor": "#2f9e44",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0C",
      "roundness": null,
      "seed": 103920690,
      "version": 586,
      "versionNonce": 500755698,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1784558096042,
      "link": null,
      "locked": false,
      "text": "    def cost(P) -> float:\n        return sum([h_i.cost for h_i in P])",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "    def cost(P) -> float:\n        return sum([h_i.cost for h_i in P])",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "uXtzJsgPZWJTEeyvNr3z2",
      "type": "text",
      "x": -419.15231549474396,
      "y": 3040.14550204234,
      "width": 712.7999877929688,
      "height": 20,
      "angle": 0,
      "strokeColor": "#343a40",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0D",
      "roundness": null,
      "seed": 602767534,
      "version": 679,
      "versionNonce": 933594414,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1784558111593,
      "link": null,
      "locked": false,
      "text": "    # Calculating the `P` cost, by the summation of each `h_i` cost in the `path`",
      "fontSize": 16,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "    # Calculating the `P` cost, by the summation of each `h_i` cost in the `path`",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "3TZpSd-lNxW95sfGMMOhd",
      "type": "text",
      "x": -884.9064269951402,
      "y": 2899.5752251012277,
      "width": 255.1999969482422,
      "height": 80,
      "angle": 0,
      "strokeColor": "#6741d9",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0E",
      "roundness": null,
      "seed": 198635566,
      "version": 313,
      "versionNonce": 873255662,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1784559146209,
      "link": null,
      "locked": false,
      "text": "start: (4 / 1 - 1) * 1   = 3\njunction (4 / 1 - 1) * 2 = 6\n> path_a: (4 / 1 - 1) * 2 = 6\ngoal: (4 / 1 - 1) * 1 = 3",
      "fontSize": 16,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "start: (4 / 1 - 1) * 1   = 3\njunction (4 / 1 - 1) * 2 = 6\n> path_a: (4 / 1 - 1) * 2 = 6\ngoal: (4 / 1 - 1) * 1 = 3",
      "autoResize": true,
      "lineHeight": 1.25
    },
