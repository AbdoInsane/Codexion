      "updated": 1784557496216,
      "link": null,
      "locked": false,
      "text": "    # Values",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "    # Values",
      "autoResize": true,
