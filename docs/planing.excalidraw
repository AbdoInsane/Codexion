    },
    {
      "id": "_Vqm2C-Gx9076hv-txFa-",
      "type": "text",
      "x": -423.0346092927415,
      "y": 2761.9509963024852,
      "width": 187,
      "height": 25,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
