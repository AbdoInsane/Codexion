      "verticalAlign": "top",
      "containerId": null,
      "originalText": "- Example:",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "EmhUxMEObvt9Y-ocPaXAG",
      "type": "text",
      "x": -419.15231589550444,
      "y": 2683.215876615251,
      "width": 462,
      "height": 50,
      "angle": 0,
      "strokeColor": "#f08c00",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
